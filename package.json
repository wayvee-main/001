    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-updates": "57.0.24",
    "expo-web-browser": "~57.0.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-calendars": "^1.1314.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0",
    "tailwindcss": "^3.4.19",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.1.1",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.2",
    "pngjs": "^3.4.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "build:web": "node scripts/validate-public-env.mjs && expo export --platform web && node scripts/stamp-service-worker.mjs && node scripts/verify-web-build.mjs",
    "preview:web": "expo serve",
    "backend:push": "npx supabase db push",
    "backend:types": "npx supabase gen types typescript --linked > src/lib/database.types.ts",
    "backend:health": "npx -y tsx scripts/check-sync.ts",
    "functions:deploy": "npx supabase functions deploy concierge",
    "eval:concierge": "npx -y tsx scripts/eval-concierge.ts",
    "audit": "node scripts/audit-app.mjs",
    "tokens": "npx -y tsx scripts/gen-tokens.ts",
    "icons": "node scripts/generate-icons.mjs",
    "tokens:contrast": "npx -y tsx scripts/check-contrast.ts",
    "auth:probe": "node scripts/validate-public-env.mjs && node scripts/probe-auth.mjs",
    "links:probe": "node --use-system-ca scripts/probe-links.mjs",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "audit:data": "npx -y tsx scripts/audit-data.ts",
    "audit:images": "npx -y tsx scripts/check-images.ts",
    "sync:events": "npx -y tsx scripts/sync-events.ts",
    "sync:viator": "npx -y tsx scripts/sync-viator.ts",
    "sync:ticketmaster": "npx -y tsx scripts/sync-ticketmaster.ts",
    "sync:places": "npx -y tsx scripts/sync-places.ts",
    "sync:weather": "npx -y tsx scripts/sync-weather.ts"
  },
  "private": true
}
