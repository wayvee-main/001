{
  "expo": {
    "name": "Wayvee",
    "slug": "wayvee001",
    "owner": "wayvee_main",
    "description": "The Bay, minus the guesswork. Eat well, catch what's on, and get there fast.",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "wayvee",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.wayvee.app"
    },
    "android": {
      "package": "com.wayvee",
      "adaptiveIcon": {
        "backgroundColor": "#FFF1ED",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.READ_CALENDAR",
        "android.permission.WRITE_CALENDAR"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFDFA",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 170,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#151117"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Wayvee to use your location while you use the app for directions, ride pickup, and useful distance estimates."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#E85D2C"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Allow Wayvee to add your planned events to your calendar."
        }
      ],
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@sentry/react-native"
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "be377ef4-3a9c-4ad5-92e2-97422df5cb15"
      }
    },
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/be377ef4-3a9c-4ad5-92e2-97422df5cb15"
    }
  }
}
